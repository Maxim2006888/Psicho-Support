<Window x:Class="Psicho_Support.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Psicho_Support.Views"
        mc:Ignorable="d"
        Title="Авторизация"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Width="400" Height="400"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <TextBlock Text="Вход"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,40"/>

        <!-- Текст состояния загрузки -->
        <TextBlock x:Name="DetailsText"
                   Foreground="LightGray"
                   FontSize="12"
                   TextAlignment="Center"
                   Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
            <Grid>
                <TextBox x:Name="LoginInput" Height="35" FontSize="16"
                         Padding="10,0"
                         Background="#2E2E3E"
                         Foreground="White"
                         BorderBrush="#5A5A7A"
                         BorderThickness="1"
                         TextChanged="Input_TextChanged"/>
                <TextBlock Text="Введите логин"
                           Foreground="#888"
                           FontSize="14"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PasswordInput"
                             Height="35"
                             FontSize="16"
                             Padding="10,0"
                             Background="#2E2E3E"
                             Foreground="White"
                             BorderBrush="#5A5A7A"
                             BorderThickness="1"/>
                <TextBlock Text="Введите пароль"
                           Foreground="#888"
                           FontSize="14"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Войти"
                    Height="40"
                    Margin="0,20,0,0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Login_Click"/>
            <Button Content="Регистрация"
                    Height="35"
                    Margin="0,10,0,0"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="#5A5A7A"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Register_Click"/>
        </StackPanel>
    </Grid>
</Window>
