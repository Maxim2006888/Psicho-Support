<Window x:Class="Psicho_Support.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="420"
        Width="360"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="30">

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="HealthPsicho Support"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 30"
                       HorizontalAlignment="Center"/>

            <!-- LOGIN -->

            <Grid Margin="0 10">

                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}">

                    <TextBox x:Name="LoginInput"
                             Padding="12"
                             FontSize="14"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="Input_TextChanged"/>

                </Border>

                <TextBlock x:Name="LoginPlaceholder"
                           Text="Введите логин"
                           Margin="12 0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsHitTestVisible="False"/>

            </Grid>


            <!-- PASSWORD -->

            <Grid Margin="0 10">

                <Border CornerRadius="10"
                        Background="{DynamicResource SurfaceBrush}">

                    <PasswordBox x:Name="PasswordInput"
                                 Padding="12"
                                 FontSize="14"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 PasswordChanged="PasswordInput_PasswordChanged"/>

                </Border>

                <TextBlock x:Name="PasswordPlaceholder"
                           Text="Введите пароль"
                           Margin="12 0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsHitTestVisible="False"/>

            </Grid>


            <!-- DETAILS TEXT -->

            <TextBlock x:Name="DetailsText"
                       Margin="0 10"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed"/>


            <!-- LOGIN BUTTON -->

            <Button Content="Войти"
                    Height="40"
                    Margin="0 20 0 10"
                    Click="Login_Click"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>


            <Button Content="Регистрация"
                    Height="35"
                    Click="Register_Click"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Cursor="Hand"/>

        </StackPanel>

    </Grid>

</Window>