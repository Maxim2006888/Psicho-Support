<Window x:Class="Psicho_Support.Views.HallowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="350">

            <TextBlock Text="Добро ожаловать"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       Margin="0 0 0 20"/>

            <TextBlock Text="Система психологической поддержки"
                       Foreground="White"
                       TextAlignment="Center"
                       FontSize="14"
                       Margin="0 0 0 40"
                       TextWrapping="Wrap"/>

            <Button Content="Войти"
                    Height="40"
                    Margin="0 10"
                    Click="Login_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="16"/>

            <Button Content="Регистрация"
                    Height="40"
                    Margin="0 10"
                    Click="Register_Click"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="16"/>

        </StackPanel>

    </Grid>
</Window>