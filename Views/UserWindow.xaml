<Window x:Class="Psicho_Support.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Psicho_Support.Views"
        mc:Ignorable="d"
        Title="HealthPsicho Support"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="1200" Height="720"
        Background="#1E1E2E"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Анимации -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
        <Storyboard x:Key="SlideFromRight">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                From="100,0,-100,0" To="0" Duration="0:0:0.4"
                                DecelerationRatio="0.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Background="#2E2E3E">
            <TextBlock Text="HealthPsicho Support"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       Margin="20,0"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,20,0">
                <Button Content="⚙ Настройки"
                        Click="Settings_Click"
                        Style="{StaticResource TopBarButtonStyle}"/>
                <Button Content="🚪 Выход"
                        Click="Exit_Click"
                        Style="{StaticResource TopBarButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Меню -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#2B2B3D" >
            <Button Content="📝 Заметки" Click="Notes_Click" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="🧠 Тесты" Click="Tests_Click" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="📊 Аналитика" Click="Analytics_Click" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="💡 Рекомендации" Click="Advice_Click" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="🏆 Достижения" Click="Achievements_Click" Style="{StaticResource MenuButtonStyle}"/>
        </StackPanel>

        <!-- Контент -->
        <!-- Текст состояния загрузки -->
        <TextBlock x:Name="DetailsText"
           Foreground="LightGray"
           FontSize="14"
           TextAlignment="Center"
           Margin="0,20,0,0"
           Visibility="Collapsed"
           Grid.ColumnSpan="3"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"/>
        
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Margin="10" Background="#3A3A4E">
            <ContentControl x:Name="MainContent" Opacity="0" Margin="0"/>
        </Border>

        <!-- Правая панель -->
        <StackPanel Grid.Row="1" Grid.Column="2" Background="#2B2B3D" >
            <TextBlock Text="Ваше состояние" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <ProgressBar x:Name="MoodBar" Minimum="0" Maximum="100" Value="70" Height="10" Margin="0,0,0,10"/>
            <TextBlock x:Name="MoodText" Text="Настроение: Хорошее" Foreground="#BBBBBB"/>
            <Separator Margin="0,12"/>
            <TextBlock Text="Время в приложении:" Foreground="#BBBBBB"/>
            <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontSize="14" Margin="0,4,0,10"/>
            <Separator Margin="0,12"/>
            <TextBlock Text="Уведомления" FontWeight="Bold" Foreground="White"/>
            <ListBox x:Name="NotificationList" Height="200" Background="#3A3A4E" Foreground="#DDDDDD">
                <ListBoxItem>Начните с раздела "Заметки"</ListBoxItem>
                <ListBoxItem>Добавлены новые тесты по стрессу</ListBoxItem>
            </ListBox>
        </StackPanel>

        <!-- Статусбар -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3" Background="#2E2E3E">
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="#AAAAAA"/>
        </StatusBar>
    </Grid>
</Window>
