<Window x:Class="Psicho_Support.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Psicho_Support.Controls"
        Title="HealthPsicho Support"
        Width="420"
        Height="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid MouseDown="OnGestureStart"
          MouseUp="OnGestureEnd">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}"
                Padding="15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="HealthPsicho"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock x:Name="DetailsText"
                               Text="{Binding WelcomeMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ShowWelcomeMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock x:Name="TimerText"
                           Grid.Column="1"
                           Margin="15,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding SessionTimeFormatted}"/>

                <Button Grid.Column="2"
                        Content="⚙"
                        Width="36"
                        Height="36"
                        Command="{Binding NavigateSettingsCommand}"/>

            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" x:Name="ContentHost">
            <ContentControl x:Name="MainContent"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform X="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <TextBlock x:Name="StatusText"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- GLASS NAVIGATION -->
        <Grid Grid.Row="2">
            <Border Background="#22000000"
                    Margin="20,10,20,0"
                    CornerRadius="30"
                    Height="70"
                    VerticalAlignment="Top"/>

            <Border Margin="20,0,20,10"
                    CornerRadius="30"
                    VerticalAlignment="Bottom"
                    Background="#55FFFFFF"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="📝"
                            FontSize="22"
                            Command="{Binding NavigateNotesCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Grid.Column="1"
                            Content="🧠"
                            FontSize="22"
                            Command="{Binding NavigateTestsCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Grid.Column="2"
                            Content="🏠"
                            FontSize="22"
                            Command="{Binding NavigateHomeCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Grid.Column="3"
                            Content="💡"
                            FontSize="22"
                            Command="{Binding NavigateAdviceCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Grid.Column="4"
                            Content="📊"
                            FontSize="22"
                            Command="{Binding NavigateAnalyticsCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>