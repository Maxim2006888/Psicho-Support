<Window x:Class="Psicho_Support.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="580"  
        Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        Loaded="Window_Loaded">

    <Border CornerRadius="18"
            Background="#282A36"
            Margin="20">

        <ScrollViewer VerticalScrollBarVisibility="Auto"  
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30">

                <!-- Заголовок -->
                <TextBlock Text="Регистрация"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Логин -->
                <TextBlock Text="Как можно к вам обращаться"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,5"/>

                <Grid>
                    <TextBox x:Name="LoginInput"
                             TextChanged="Input_TextChanged"
                             Background="#3A3A4A"
                             BorderThickness="0"
                             Foreground="White"
                             Padding="10"
                             Height="40"/>

                    <TextBlock x:Name="LoginPlaceholder"
                               Text="Введите логин"
                               Foreground="#777777"
                               Padding="10"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Пароль -->
                <TextBlock Text="Пароль"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,15,0,5"/>

                <Grid>
                    <PasswordBox x:Name="PasswordInput"
                                 PasswordChanged="PasswordInput_PasswordChanged"
                                 Background="#3A3A4A"
                                 BorderThickness="0"
                                 Foreground="White"
                                 Padding="10"
                                 Height="40"/>

                    <TextBlock x:Name="PasswordPlaceholder"
                               Text="Введите пароль"
                               Foreground="#777777"
                               Padding="10"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Индикатор сложности пароля -->
                <TextBlock x:Name="PasswordStrengthIndicator"
                           FontSize="11"
                           Margin="0,5,0,0"/>

                <!-- Подтверждение пароля -->
                <TextBlock Text="Подтверждение пароля"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,15,0,5"/>

                <Grid>
                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 PasswordChanged="ConfirmPasswordInput_PasswordChanged"
                                 Background="#3A3A4A"
                                 BorderThickness="0"
                                 Foreground="White"
                                 Padding="10"
                                 Height="40"/>

                    <TextBlock x:Name="ConfirmPasswordPlaceholder"
                               Text="Повторите пароль"
                               Foreground="#777777"
                               Padding="10"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Индикатор совпадения паролей -->
                <TextBlock x:Name="PasswordMatchIndicator"
                           FontSize="11"
                           Margin="0,5,0,15"/>

                <!-- Кнопки -->
                <Button Content="Зарегистрироваться"
                        Click="Register_Click"
                        Height="40"
                        Background="#5A4FCF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Margin="0,20,0,10"/>

                <Button Content="Назад"
                        Click="Back_Click"
                        Height="40"
                        Background="Transparent"
                        Foreground="#AAAAAA"
                        BorderBrush="#AAAAAA"
                        BorderThickness="1"
                        FontSize="14"
                        Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>