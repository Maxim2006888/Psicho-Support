<Window x:Class="Psicho_Support.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Psicho_Support.Views"
        mc:Ignorable="d"
        Title="Регистрация"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Width="400"
        Height="500"
        Background="#1E1E2E"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <!-- Заголовок -->
        <TextBlock Text="Регистрация"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#F8F8F2"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <!-- Контейнер для полей -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="260">
            <!-- Логин -->
            <Grid>
                <TextBox x:Name="LoginInput"
                         Height="35"
                         FontSize="16"
                         Padding="10,0"
                         Background="#2E2E3E"
                         Foreground="White"
                         BorderBrush="#5A5A7A"
                         BorderThickness="1"
                         TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="LoginPlaceholder"
                           Text="Введите логин"
                           Foreground="#888"
                           FontSize="14"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <!-- Пароль -->
            <Grid>
                <PasswordBox x:Name="PasswordInput"
                             Height="35"
                             FontSize="16"
                             Padding="10,0"
                             Background="#2E2E3E"
                             Foreground="White"
                             BorderBrush="#5A5A7A"
                             BorderThickness="1"
                             PasswordChanged="PasswordInput_PasswordChanged"/>
                <TextBlock x:Name="PasswordPlaceholder"
                           Text="Введите пароль"
                           Foreground="#888"
                           FontSize="14"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
            <!-- Текст состояния загрузки -->
            <TextBlock x:Name="DetailsText"
                       Foreground="LightGray"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <!-- Кнопка регистрации -->
            <Button Content="Зарегистрироваться"
                    Click="Register_Click"
                    Height="40"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#6272A4"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#6272A4"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7082C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#505070"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Кнопка назад -->
            <Button Content="Назад"
                    Click="Back_Click"
                    Height="35"
                    FontSize="14"
                    Foreground="#CCCCCC"
                    Background="Transparent"
                    BorderBrush="#5A5A7A"
                    BorderThickness="1"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
