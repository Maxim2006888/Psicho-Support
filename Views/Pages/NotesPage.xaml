<UserControl x:Class="Psicho_Support.Views.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Psicho_Support.Helpers"
             Background="#1E1E2F">

    <UserControl.Resources>
        <!-- Конвертеры для заметок -->
        <helpers:StressToCardColorConverter x:Key="StressToCardColorConverter"/>
        <helpers:StressToTextColorConverter x:Key="StressToTextColorConverter"/>
        <helpers:StressToEmojiConverter x:Key="StressToEmojiConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- РЕЖИМ СПИСКА ЗАМЕТОК -->
        <Grid x:Name="ListMode" 
              Visibility="{Binding ListModeVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="25,20,25,10">
                <TextBlock Text="Мои заметки"
                          FontSize="26"
                          FontWeight="SemiBold"
                          Foreground="White"/>
                <TextBlock Text="Иногда слова помогают понять себя"
                          FontSize="13"
                          Foreground="#AAAAAA"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Статистика -->
            <Border Grid.Row="1"
                    Margin="20,0,20,10"
                    Padding="12"
                    CornerRadius="8"
                    Background="#2A2A3D">
                <TextBlock Text="{Binding NotesStatistics}"
                          Foreground="#AAAAAA"
                          FontSize="12"
                          TextAlignment="Center"/>
            </Border>

            <!-- Поиск и кнопка добавления -->
            <Grid Grid.Row="2" Margin="20,0,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поле поиска -->
                <Border Grid.Column="0"
                        CornerRadius="12"
                        Background="#2A2A3D"
                        Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="14"
                             Padding="12"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- Кнопка создания заметки -->
                <Border Grid.Column="1"
                        Width="50"
                        Height="50"
                        CornerRadius="12"
                        Background="#5A4FCF">
                    <Button Content="➕"
                            Command="{Binding CreateNewNoteCommand}"
                            FontSize="24"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Создать заметку"/>
                </Border>
            </Grid>

            <!-- Список заметок с цветными карточками -->
            <ListBox Grid.Row="3"
                     Margin="15,0,15,15"
                     ItemsSource="{Binding NotesView}"
                     SelectedItem="{Binding SelectedNote}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка с цветом от уровня стресса -->
                        <Border Style="{StaticResource NoteCardStyle}"
                                Background="{Binding StressLevel, Converter={StaticResource StressToCardColorConverter}}">

                            <StackPanel>
                                <!-- Верхняя строка: иконка эмоции + заголовок -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StressLevel, Converter={StaticResource StressToEmojiConverter}}" 
                                               FontSize="18" 
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}"
                                              FontWeight="Bold"
                                              Foreground="White"
                                              FontSize="14"
                                              TextTrimming="CharacterEllipsis"
                                              MaxWidth="250"/>
                                </StackPanel>

                                <!-- Содержимое заметки с переносом текста -->
                                <TextBlock Text="{Binding Content}"
                                          Foreground="#F0F0F0"
                                          FontSize="12"
                                          Margin="0,6,0,0"
                                          TextWrapping="Wrap"
                                          TextTrimming="WordEllipsis"
                                          MaxHeight="60"
                                          LineHeight="1.4"/>

                                <!-- Нижняя строка: дата и индикатор стресса -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                              Foreground="#E0E0E0"
                                              FontSize="10"
                                              Opacity="0.8"/>

                                    <!-- Индикатор стресса с процентом -->
                                    <Border Grid.Column="1"
                                            Background="#FFFFFF"
                                            CornerRadius="12"
                                            Padding="8,2"
                                            Margin="5,0,0,0"
                                            Opacity="0.9">
                                        <TextBlock Foreground="{Binding StressLevel, Converter={StaticResource StressToTextColorConverter}}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <Run Text="{Binding StressLevel}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- РЕЖИМ РЕДАКТОРА (остаётся без изменений) -->
        <Grid x:Name="EditorMode" 
              Visibility="{Binding EditorModeVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="#2A2A3D"
                    Padding="15"
                    CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="8"
                            Background="Transparent">
                        <Button Command="{Binding BackToListCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="24"
                                Content="←"
                                ToolTip="Вернуться к списку"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding EditModeTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <Border Grid.Column="2"
                            Width="40"
                            Height="40"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="0,0,5,0">
                        <Button Command="{Binding SaveNoteCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#5A4FCF"
                                FontSize="20"
                                Content="💾"
                                ToolTip="Сохранить"/>
                    </Border>

                    <Border Grid.Column="3"
                            Width="40"
                            Height="40"
                            CornerRadius="8"
                            Background="Transparent">
                        <Button Command="{Binding DeleteNoteCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF5555"
                                FontSize="20"
                                Content="🗑"
                                IsEnabled="{Binding CanDelete}"
                                ToolTip="Удалить"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Редактор -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20">
                <TextBox Text="{Binding EditingNote.Content, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextBox_TextChanged"  
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="16"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="400"
                         CaretBrush="#5A4FCF"
                         FontFamily="Segoe UI"/>
            </ScrollViewer>

            <!-- Нижняя панель с информацией -->
            <Border Grid.Row="2"
                    Background="#2A2A3D"
                    Padding="15"
                    CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="#777777" FontSize="12">
                            <Run Text="Создано: "/>
                            <Run Text="{Binding EditingNote.CreatedAt, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}"/>
                        </TextBlock>

                        <StackPanel Margin="0,4,0,0" 
                                    Visibility="{Binding StressInfoVisibility}">
                            <TextBlock Foreground="#777777" FontSize="12">
                                <Run Text="Уровень стресса: "/>
                                <Run Text="{Binding EditingNote.StressLevel, Mode=OneWay}"/>
                                <Run Text="% "/>
                                <Run Text="("/>
                                <Run Text="{Binding StressText, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{Binding StressColor, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="10,4"
                            Visibility="{Binding StressInfoVisibility}">
                        <TextBlock Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <Run Text="{Binding EditingNote.StressLevel, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>