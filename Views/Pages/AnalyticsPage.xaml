<local:BasePage x:Class="Psicho_Support.Views.Pages.AnalyticsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Psicho_Support.Views.Pages"
                Background="#2A2A3D">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock x:Name="TotalTimeSpentText" 
                       Foreground="White" 
                       FontSize="18" 
                       Margin="0,0,0,10" Width="77"/>

            <TextBlock x:Name="SessionCountText" 
                       Foreground="White" 
                       FontSize="18" 
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="AverageSessionDurationText" 
                       Foreground="White" 
                       FontSize="18" 
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="ActivityLast7DaysText" 
                       Foreground="White" 
                       FontSize="18"/>
        </StackPanel>
    </Grid>
</local:BasePage>