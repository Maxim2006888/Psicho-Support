<UserControl x:Class="Psicho_Support.Views.Pages.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Psicho_Support.Helpers"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#1E1E2F">

    <UserControl.Resources>
        <helpers:StateToEmojiConverter x:Key="StateToEmojiConverter"/>
        <helpers:StateToColorConverter x:Key="StateToColorConverter"/>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:ExpandCollapseIconConverter x:Key="ExpandCollapseIconConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="15">

            <!-- Заголовок -->
            <TextBlock Text="📊 Аналитика"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- ========== РАЗДЕЛ 1: ОСНОВНАЯ СТАТИСТИКА ========== -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="#2A2A3D"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Заголовок с кнопкой раскрытия -->
                    <Button Command="{Binding ToggleSection1Command}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="📊 Основная статистика"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding IsSection1Expanded, Converter={StaticResource ExpandCollapseIconConverter}}"
                                       FontSize="18"
                                       Foreground="#AAAAAA"/>
                        </Grid>
                    </Button>

                    <!-- Содержимое (раскрывается) -->
                    <StackPanel Visibility="{Binding IsSection1Expanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Время в приложении -->
                            <Border Background="#1E1E2F" 
                                    CornerRadius="12" 
                                    Padding="12" 
                                    Margin="0,0,5,5">
                                <StackPanel>
                                    <TextBlock Text="⏱️ Время" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalTimeFormatted}" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="всего" Foreground="#AAAAAA" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <!-- Количество сессий -->
                            <Border Background="#1E1E2F" 
                                    CornerRadius="12" 
                                    Padding="12" 
                                    Margin="5,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="📱 Сессии" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding SessionCount}" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="всего" Foreground="#AAAAAA" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <!-- Среднее время -->
                            <Border Grid.Row="1" Grid.Column="0" 
                                    Background="#1E1E2F" 
                                    CornerRadius="12" 
                                    Padding="12" 
                                    Margin="0,5,5,0">
                                <StackPanel>
                                    <TextBlock Text="⏳ Среднее" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding AverageTimeFormatted}" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="за сессию" Foreground="#AAAAAA" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <!-- Активность за неделю -->
                            <Border Grid.Row="1" Grid.Column="1" 
                                    Background="#1E1E2F" 
                                    CornerRadius="12" 
                                    Padding="12" 
                                    Margin="5,5,0,0">
                                <StackPanel>
                                    <TextBlock Text="📅 Активность" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding Activity}" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding WeekActivityPercentage, StringFormat='{}{0:F0}% от макс.'}" 
                                               Foreground="#AAAAAA" 
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#1E1E2F"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="📝 Заметки сегодня" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayNotesCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#1E1E2F"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🧠 Тесты сегодня" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock Text="{Binding TodayTestsCount}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== РАЗДЕЛ 2: ЭМОЦИОНАЛЬНОЕ СОСТОЯНИЕ ========== -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="#2A2A3D"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Заголовок с кнопкой раскрытия -->
                    <Button Command="{Binding ToggleSection2Command}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="😊 Эмоциональное состояние"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding IsSection2Expanded, Converter={StaticResource ExpandCollapseIconConverter}}"
                                       FontSize="18"
                                       Foreground="#AAAAAA"/>
                        </Grid>
                    </Button>

                    <!-- Содержимое (раскрывается) -->
                    <StackPanel Visibility="{Binding IsSection2Expanded, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Превью состояния -->
                        <Grid Margin="0,10,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding CurrentStateValue, Converter={StaticResource StateToEmojiConverter}}"
                                       FontSize="48"
                                       Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding CurrentStateLevel}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{Binding CurrentStateColor, Converter={StaticResource StringToBrushConverter}}"/>
                                <TextBlock Text="{Binding CurrentStateValue, StringFormat='{}{0}%'}"
                                           FontSize="14"
                                           Foreground="#AAAAAA"/>
                            </StackPanel>
                        </Grid>

                        <!-- Прогресс-бар (без CornerRadius) -->
                        <ProgressBar Value="{Binding CurrentStateValue}" 
                                     Maximum="100"
                                     Height="8"
                                     Foreground="{Binding CurrentStateColor, Converter={StaticResource StringToBrushConverter}}"
                                     Background="#3A3A4D"/>

                        <!-- Совет -->
                        <Border Background="#1E1E2F" CornerRadius="12" Padding="12" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 Совет" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="#AAAAAA"/>
                                <TextBlock Text="{Binding StateAdvice}"
                                           FontSize="12"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========== РАЗДЕЛ 3: ДИНАМИКА ========== -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="#2A2A3D"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Заголовок с кнопкой раскрытия -->
                    <Button Command="{Binding ToggleSection3Command}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="📈 Динамика"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding IsSection3Expanded, Converter={StaticResource ExpandCollapseIconConverter}}"
                                       FontSize="18"
                                       Foreground="#AAAAAA"/>
                        </Grid>
                    </Button>

                    <!-- Содержимое (раскрывается) -->
                    <StackPanel Visibility="{Binding IsSection3Expanded, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Тенденция -->
                            <Border Background="#1E1E2F" CornerRadius="12" Padding="12" Margin="0,0,5,5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding TrendIcon}" FontSize="24" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TrendText}" 
                                                   FontSize="18" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding TrendColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TrendDescription}"
                                               FontSize="11"
                                               Foreground="#AAAAAA"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Прогрессия -->
                            <Border Background="#1E1E2F" CornerRadius="12" Padding="12" Margin="5,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding ImprovementText}" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="{Binding ImprovementColor, Converter={StaticResource StringToBrushConverter}}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding ImprovementDescription}"
                                               FontSize="11"
                                               Foreground="#AAAAAA"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <!-- Прогресс-бар без CornerRadius -->
                                    <ProgressBar Value="{Binding ImprovementPercentage}" 
                                                 Maximum="100"
                                                 Height="4"
                                                 Margin="0,10,0,0"
                                                 Foreground="{Binding ImprovementColor, Converter={StaticResource StringToBrushConverter}}"
                                                 Background="#3A3A4D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Дополнительная статистика -->
                        <Border Background="#1E1E2F" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="📊 Сравнение" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="#AAAAAA"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Прошлая неделя" Foreground="#AAAAAA" FontSize="10"/>
                                        <TextBlock Text="{Binding PreviousWeekStress, StringFormat='{}{0}%'}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold" 
                                                   Foreground="#FF9800"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="→" Foreground="#AAAAAA" FontSize="14" Margin="10,0"/>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Эта неделя" Foreground="#AAAAAA" FontSize="10"/>
                                        <TextBlock Text="{Binding CurrentWeekStress, StringFormat='{}{0}%'}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding CurrentStateColor, Converter={StaticResource StringToBrushConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 📈 График стресса -->
                        <Border Background="#1E1E2F" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="📈 Динамика стресса"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,8"/>

                                <lvc:CartesianChart
                                    Series="{Binding StressSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    Height="200"
                                    AnimationsSpeed="0:0:0.6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопка обновления -->
            <Button Command="{Binding RefreshCommand}"
                    Background="#5A4FCF"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15"
                    Margin="0,10,0,20"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 " FontSize="14"/>
                    <TextBlock Text="Обновить данные" FontSize="14"/>
                </StackPanel>
            </Button>

            <!-- Индикатор загрузки -->
            <Border Background="#2A2A3D"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,0,20"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏳ Загрузка..."
                               Foreground="#AAAAAA"
                               FontSize="12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>