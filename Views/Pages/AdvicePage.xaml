<!-- Views/Pages/AdvicePage.xaml - альтернативная версия -->
<UserControl x:Class="Psicho_Support.Views.Pages.AdvicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Psicho_Support.Helpers"
             Background="Transparent">

    <UserControl.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <helpers:StateToColorConverter x:Key="StateToColorConverter"/>
        <helpers:StateToEmojiConverter x:Key="StateToEmojiConverter"/>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заголовок -->
            <TextBlock Text="💡 Советы и рекомендации"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- Индикатор состояния -->
            <Border Background="{Binding StateValue, Converter={StaticResource StateToColorConverter}}"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StateValue}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Текущее состояние"
                                   FontSize="12"
                                   Foreground="#E0E0E0"/>
                        <TextBlock Text="{Binding StateLevel}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StateValue, Converter={StaticResource StateToEmojiConverter}}"
                               FontSize="32"
                               Foreground="White"/>
                </Grid>
            </Border>

            <!-- Советы -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="📋 Рекомендации"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="{Binding AdviceText}"
                               FontSize="14"
                               LineHeight="1.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Дополнительные ресурсы -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="🆘 Если вам нужна помощь"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="1.4"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Inlines>
                            <Run Text="• Горячая линия психологической помощи: 8-800-200-0-122"/>
                            <LineBreak/>
                            <Run Text="• Экстренная помощь: 112"/>
                            <LineBreak/>
                            <Run Text="• Чат поддержки: psi-help.ru"/>
                            <LineBreak/>
                            <Run Text="• Круглосуточная линия доверия: 8-800-333-44-34"/>
                            <LineBreak/>
                            <Run Text="• Детская линия помощи: 8-800-2000-122"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                    
                    <TextBlock Text="📱 Приложения для самопомощи:"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,15,0,5"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="1.4"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Inlines>
                            <Run Text="• Calm - медитация и дыхательные практики"/>
                            <LineBreak/>
                            <Run Text="• Headspace - осознанность и снятие стресса"/>
                            <LineBreak/>
                            <Run Text="• MoodTools - инструменты для улучшения настроения"/>
                            <LineBreak/>
                            <Run Text="• Woebot - AI-помощник для эмоциональной поддержки"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Индикатор загрузки -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,20,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏳ Обновление рекомендаций..."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>