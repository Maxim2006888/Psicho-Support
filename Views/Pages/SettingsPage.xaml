<UserControl
    x:Class="Psicho_Support.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#3AFFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0 0 0 14"/>
        </Style>

        <Style x:Key="SettingsHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="860" HorizontalAlignment="Center">
                <StackPanel>

                    <TextBlock
                        Text="Настройки"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0 0 0 6"/>

                    <TextBlock
                        Text="Персонализация и комфорт среды"
                        Style="{StaticResource HintTextStyle}"
                        Margin="0 0 0 18"/>

                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0 0 8 0">
                            <StackPanel>
                                <TextBlock Text="Пользователь" Style="{StaticResource SettingsHeaderStyle}"/>
                                <TextBlock Text="Активный аккаунт" Style="{StaticResource HintTextStyle}"/>
                                <TextBox x:Name="UsernameBox" IsReadOnly="True" Height="36"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Margin="8 0 0 0">
                            <StackPanel>
                                <TextBlock Text="Текущая сессия" Style="{StaticResource SettingsHeaderStyle}"/>
                                <TextBlock Text="Время с момента входа" Style="{StaticResource HintTextStyle}"/>
                                <TextBlock x:Name="SessionTimeText" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Тема приложения" Style="{StaticResource SettingsHeaderStyle}"/>
                            <TextBlock Text="Переключите цветовой режим интерфейса" Style="{StaticResource HintTextStyle}"/>
                            <ToggleButton
                                x:Name="ThemeToggle"
                                Content="Тёмная тема"
                                Height="36"
                                Checked="ThemeToggle_Checked"
                                Unchecked="ThemeToggle_Unchecked"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ambient-плеер (preview)" Style="{StaticResource SettingsHeaderStyle}"/>
                            <TextBlock Text="Выберите фоновую атмосферу. Это визуальная заглушка: без реального аудио-движка." Style="{StaticResource HintTextStyle}"/>

                            <Grid Margin="0 0 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="AmbientPresetCombo"
                                          Height="34"
                                          SelectedIndex="0"
                                          Margin="0 0 10 0">
                                    <ComboBoxItem Content="Lo-fi Focus"/>
                                    <ComboBoxItem Content="Rain Calm"/>
                                    <ComboBoxItem Content="Soft Piano"/>
                                    <ComboBoxItem Content="Space Ambient"/>
                                </ComboBox>

                                <Button Grid.Column="1"
                                        Content="▶"
                                        ToolTip="Включить"
                                        Height="34"
                                        Margin="0 0 10 0"
                                        Click="AmbientPlay_Click"/>

                                <Button Grid.Column="2"
                                        Content="⏹"
                                        ToolTip="Остановить"
                                        Height="34"
                                        Click="AmbientStop_Click"/>
                            </Grid>

                            <Border Background="#22000000" CornerRadius="10" Padding="10">
                                <TextBlock x:Name="AmbientStatusText"
                                           Text="Статус: выключено"
                                           Foreground="#E0E0E0"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button
                        Content="Выйти из аккаунта"
                        Height="44"
                        Background="#C3424A"
                        Foreground="White"
                        Margin="0 10 0 30"
                        Click="Logout_Click"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>