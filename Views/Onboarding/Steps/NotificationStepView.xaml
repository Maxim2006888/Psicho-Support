<!-- Views/Onboarding/Steps/NotificationStepView.xaml -->
<UserControl x:Class="Psicho_Support.Views.Onboarding.Steps.NotificationStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
        <TextBlock Text="🔔" FontSize="64" HorizontalAlignment="Center"/>

        <TextBlock Text="Уведомления"
                   FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,8"/>

        <TextBlock Text="Мы будем присылать напоминания, чтобы помочь тебе не забывать о себе"
                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" 
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

        <Button Content="Включить уведомления"
                Click="EnableNotifications_Click"
                Background="{DynamicResource AccentBrush}" Foreground="White"
                Padding="20,10" Cursor="Hand"/>

        <TextBlock Text="Ты всегда сможешь отключить их в настройках"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>