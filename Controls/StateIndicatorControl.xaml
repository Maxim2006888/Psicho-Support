<UserControl x:Class="Psicho_Support.Controls.StateIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl"
             Cursor="Hand">

    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseBorder"
                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.15" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="PulseBorder"
                             Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.15" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.9" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="(Border.Effect).Radius"
                             From="12" To="18" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="GlowEffect"
                Width="130"
                Height="130"
                CornerRadius="65"
                Background="{Binding StateColor, ElementName=UserControl}"
                Opacity="0.5">
            <Border.Effect>
                <BlurEffect Radius="12"/>
            </Border.Effect>
        </Border>

        <Border x:Name="PulseBorder"
                Width="130"
                Height="130"
                CornerRadius="65"
                Background="Transparent"
                BorderBrush="{Binding StateColor, ElementName=UserControl}"
                BorderThickness="3"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
        </Border>

        <Border x:Name="Indicator"
                Width="120"
                Height="120"
                CornerRadius="60"
                Background="{Binding StateColor, ElementName=UserControl}"
                BorderBrush="White"
                BorderThickness="2">

            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0">
                <TextBlock x:Name="StateEmoji"
                          FontSize="24"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>

                <TextBlock x:Name="StateText"
                          Text="{Binding StateLevel, ElementName=UserControl}"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,2"/>

                <TextBlock x:Name="ValueText"
                          Text="{Binding Value, ElementName=UserControl}"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>