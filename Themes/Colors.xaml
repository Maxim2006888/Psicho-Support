<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Основные цвета -->
    <Color x:Key="BackgroundColor">#1E1E2E</Color>
    <Color x:Key="SurfaceColor">#262637</Color>
    <Color x:Key="SurfaceLightColor">#2A2A3D</Color>
    <Color x:Key="SurfaceDarkColor">#1E1E2F</Color>

    <Color x:Key="AccentColor">#5A4FCF</Color>
    <Color x:Key="AccentLightColor">#7C6FF0</Color>
    <Color x:Key="HighlightColor">#7082C4</Color>

    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="InfoColor">#0e103d</Color>
    <Color x:Key="SupportColor">#154230</Color>

    <Color x:Key="TextPrimaryColor">#F8F8F2</Color>
    <Color x:Key="TextSecondaryColor">#AAAAAA</Color>
    <Color x:Key="TextMutedColor">#777777</Color>

    <Color x:Key="BorderColor">#33334A</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SupportBrush" Color="{StaticResource SupportColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- Геометрические параметры -->
    <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DefaultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>

    <Thickness x:Key="SmallPadding">10</Thickness>
    <Thickness x:Key="DefaultPadding">20</Thickness>
    <Thickness x:Key="LargePadding">30</Thickness>

    <!-- Тени -->
    <DropShadowEffect x:Key="SoftShadow"
                      BlurRadius="25"
                      ShadowDepth="0"
                      Opacity="0.35"/>

    <DropShadowEffect x:Key="StrongShadow"
                      BlurRadius="30"
                      ShadowDepth="2"
                      Opacity="0.5"/>

    <!-- Шрифты (используем system:Double) -->
    <system:Double x:Key="SmallFontSize">12</system:Double>
    <system:Double x:Key="DefaultFontSize">14</system:Double>
    <system:Double x:Key="LargeFontSize">16</system:Double>
    <system:Double x:Key="TitleFontSize">24</system:Double>

</ResourceDictionary>