<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета -->
    <Color x:Key="BackgroundColor">#F4F6F8</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#2AABEE</Color>
    <Color x:Key="TextColor">#1E1E1E</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SideBarBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RightPanelBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#DDDDDD"/>

</ResourceDictionary>