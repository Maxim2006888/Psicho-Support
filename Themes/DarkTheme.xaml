<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета -->
    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="CardColor">#2D2D30</Color>
    <Color x:Key="PrimaryColor">#2AABEE</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

    <SolidColorBrush x:Key="TopBarBrush" Color="#2E2E3E"/>
    <SolidColorBrush x:Key="SideBarBrush" Color="#2B2B3D"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#3A3A4E"/>
    <SolidColorBrush x:Key="RightPanelBrush" Color="#2B2B3D"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#2E2E3E"/>

    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="BorderBrushColor" Color="#444444"/>

</ResourceDictionary>